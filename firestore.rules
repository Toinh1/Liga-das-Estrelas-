rules_version = '2';
// =============================================================================
// FutebolB3 — Regras de segurança do Cloud Firestore
// Papéis: 'admin' (gerencia tudo) e 'player' (visualiza; edita só o próprio perfil, vota e envia fotos).
// Publicar com:  firebase deploy --only firestore:rules
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUserDoc() {
      return get(userPath(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(userPath(request.auth.uid)) && currentUserDoc().role == 'admin';
    }

    function currentPlayerId() {
      return currentUserDoc().playerId;
    }

    function getPelada(peladaId) {
      return get(/databases/$(database)/documents/peladas/$(peladaId)).data;
    }

    function bootstrapExists() {
      return exists(/databases/$(database)/documents/meta/bootstrap);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------------------------------------------------------- USUÁRIOS
    match /users/{userId} {
      allow read: if isSignedIn();

      // Criação da própria conta. O jogador vinculado precisa ficar com userId = uid
      // no MESMO batch (getAfter). Só o primeiro cadastro (sem bootstrap) pode ser admin.
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.id == userId
        && (request.resource.data.role == 'player'
            || (request.resource.data.role == 'admin' && !bootstrapExists()))
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.userId == request.auth.uid;

      // O usuário só pode alterar o próprio nome. Papel e jogador vinculado são imutáveis.
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId && changedOnly(['name']));

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------- META
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && docId == 'bootstrap' && !bootstrapExists()
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'admin';
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------- JOGADORES
    match /players/{playerId} {
      allow read: if isSignedIn();

      // Admin cria qualquer jogador. Jogador cria apenas o próprio perfil no cadastro,
      // sem definir nível técnico nem status (exclusivos do admin).
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == playerId
        && getAfter(userPath(request.auth.uid)).data.playerId == playerId
        && !('skillLevel' in request.resource.data)
        && !('active' in request.resource.data)
      );

      allow update: if isAdmin()
        // Dono do perfil: só dados pessoais
        || (isSignedIn()
            && resource.data.get('userId', null) == request.auth.uid
            && changedOnly(['name', 'nickname', 'photoUrl', 'position', 'dominantFoot', 'updatedAt']))
        // Vínculo de conta nova a um jogador cadastrado pelo admin (ainda sem conta)
        || (isSignedIn()
            && resource.data.get('userId', null) == null
            && request.resource.data.userId == request.auth.uid
            && getAfter(userPath(request.auth.uid)).data.playerId == playerId
            && changedOnly(['userId', 'email', 'nickname', 'position', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------- LINHAS (EQUIPES)
    match /lines/{lineId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------- TEMPORADAS
    match /seasons/{seasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- PELADAS
    match /peladas/{peladaId} {
      allow read: if isSignedIn();
      // Somente o admin cria, edita (inclusive a lista de presença) e exclui.
      // Jogadores apenas visualizam.
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------- PARTIDAS, RESULTADOS E GOLS
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Ajustes históricos de gols (antes do registro por partida)
    match /goals/{goalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------ VOTOS
    // Secretos até o encerramento. 1 voto por categoria (ID determinístico),
    // apenas jogadores escalados, proibido votar em si mesmo.
    match /votes/{voteId} {
      allow read: if isSignedIn() && (
        resource.data.voterUserId == request.auth.uid
        || getPelada(resource.data.peladaId).votingStatus == 'closed'
        || getPelada(resource.data.peladaId).status == 'finished'
      );

      allow create: if isSignedIn()
        && voteId == (request.resource.data.peladaId + '_' + currentPlayerId() + '_' + request.resource.data.category)
        && request.resource.data.voterUserId == request.auth.uid
        && request.resource.data.voterPlayerId == currentPlayerId()
        && request.resource.data.candidatePlayerId != currentPlayerId()
        && (request.resource.data.category == 'best_player' || request.resource.data.category == 'best_goalkeeper')
        && getPelada(request.resource.data.peladaId).votingStatus == 'open'
        && currentPlayerId() in getPelada(request.resource.data.peladaId).presentPlayerIds
        && request.resource.data.candidatePlayerId in getPelada(request.resource.data.peladaId).presentPlayerIds;

      allow update: if false;
      // Somente para limpeza em cascata ao excluir uma pelada
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- PREMIAÇÕES
    match /awards/{awardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------ FOTOS
    match /photos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.uploadedByUserId == request.auth.uid
        && request.resource.data.isOfficial == false
        && getPelada(request.resource.data.peladaId).allowPlayerUploads == true
      );
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.uploadedByUserId == request.auth.uid
        && changedOnly(['caption', 'taggedPlayerIds'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploadedByUserId == request.auth.uid);
    }

    // ---------------------------------------------------------------- AVISOS
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // Qualquer usuário pode apenas marcar o aviso como lido por ele mesmo
      allow update: if isAdmin() || (
        isSignedIn()
        && changedOnly(['readByUserIds'])
        && request.resource.data.readByUserIds.toSet()
             .difference(resource.data.readByUserIds.toSet())
             .hasOnly([request.auth.uid])
      );
    }
  }
}
